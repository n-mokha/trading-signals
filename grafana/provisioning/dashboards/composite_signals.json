{
  "uid": "composite-signals",
  "title": "Composite Signal Scores",
  "description": "Tier 2 engine output — composite scores (0–100) per symbol. >65 = bullish, <35 = bearish. Refreshes every 15 min.",
  "tags": ["signals", "composite"],
  "timezone": "browser",
  "refresh": "5m",
  "schemaVersion": 39,
  "time": {"from": "now-24h", "to": "now"},
