    {
      "id": 17, "type": "timeseries",
      "title": "Composite Score — All Symbols",
      "description": "Engine runs every 15 min. Scores above 65 are bullish (green zone), below 35 are bearish (red zone). VIX dampening pulls scores toward 50 in volatile markets.",
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 22},
      "datasource": {"type": "postgres", "uid": "tradingsignals"},
      "options": {
        "tooltip": {"mode": "multi", "sort": "desc"},
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": true,
            "showPoints": "auto",
            "pointSize": 4
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "#d73027", "value": null},
              {"color": "#f4a736", "value": 35},
              {"color": "#1a9641", "value": 65}
            ]
          }
        },
        "overrides": []
      },
      "targets": [{"datasource": {"type": "postgres", "uid": "tradingsignals"},
        "format": "time_series", "rawQuery": true, "refId": "A",
        "rawSql": "SELECT\n  time_bucket('15 minutes', time) AS time,\n  symbol AS metric,\n  ROUND(composite_score::numeric, 1) AS value\nFROM signals\nWHERE $__timeFilter(time)\nGROUP BY 1, symbol, composite_score\nORDER BY 1, 2"
      }]
    },
    {
      "id": 18, "type": "row", "title": "Signal Breakdown",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 34},
      "panels": []
    },
    {
      "id": 19, "type": "table",
      "title": "Latest Score Breakdown per Symbol",
      "description": "Sub-scores from each signal source. Price and fundamental drive 70% of the composite. Insider is 10%, sentiment 20% (disabled when Reddit is off). Macro modifier scales toward 50 during high VIX.",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 35},
      "datasource": {"type": "postgres", "uid": "tradingsignals"},
      "options": {
        "showHeader": true,
        "sortBy": [{"displayName": "Composite", "desc": true}],
        "cellHeight": "md",
        "footer": {"show": false}
      },
      "fieldConfig": {
        "defaults": {
          "custom": {"align": "auto", "displayMode": "auto", "filterable": false}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Composite"},
            "properties": [
              {"id": "decimals", "value": 1},
              {"id": "custom.displayMode", "value": "color-background"},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [
                {"color": "#d73027", "value": null},
                {"color": "#f4a736", "value": 35},
                {"color": "#1a9641", "value": 65}
              ]}},
              {"id": "color", "value": {"mode": "thresholds"}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Last Updated"},
            "properties": [{"id": "unit", "value": "dateTimeFromNow"}]
          }
        ]
      },
      "targets": [{"datasource": {"type": "postgres", "uid": "tradingsignals"},
        "format": "table", "rawQuery": true, "refId": "A",
        "rawSql": "SELECT DISTINCT ON (symbol)\n  symbol                                                        AS \"Symbol\",\n  ROUND(composite_score::numeric, 1)                            AS \"Composite\",\n  ROUND(COALESCE(price_score, 0)::numeric, 2)                   AS \"Price\",\n  ROUND(COALESCE(fundamental_score, 0)::numeric, 2)             AS \"Fundamental\",\n  ROUND(COALESCE(insider_score, 0)::numeric, 2)                 AS \"Insider\",\n  ROUND(COALESCE(sentiment_score, 0)::numeric, 2)               AS \"Sentiment\",\n  ROUND(macro_modifier::numeric, 3)                             AS \"Macro Mod\",\n  time                                                          AS \"Last Updated\"\nFROM signals\nORDER BY symbol, time DESC"
      }]
    }
  ],
  "version": 1
}
