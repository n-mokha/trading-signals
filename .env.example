# Copy this file to .env and fill in your values.
# Never commit .env to git.

# --- Database ---
DB_PASSWORD=changeme_strong_password

# --- Price Data ---
POLYGON_API_KEY=your_polygon_api_key_here

# --- Fundamentals ---
FMP_API_KEY=your_fmp_api_key_here

# --- Macro ---
FRED_API_KEY=your_fred_api_key_here   # free at https://fred.stlouisfed.org/docs/api/api_key.html

# --- Reddit (create an app at https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# --- Congressional Trades (optional — Capitol Trades is public, no key needed) ---
UNUSUAL_WHALES_API_KEY=         # leave blank to skip; get at unusualwhales.com

# --- Email Alerts (Tier 3) ---
# Set alerts.enabled: true in config/signals.yaml to activate
# For Gmail: use an App Password (myaccount.google.com/apppasswords), not your main password
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=your_gmail@gmail.com
ALERT_SMTP_PASSWORD=your_app_password_here
ALERT_EMAIL_TO=your_email@gmail.com

# --- Internal ---
DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=tradingsignals
DB_USER=postgres
